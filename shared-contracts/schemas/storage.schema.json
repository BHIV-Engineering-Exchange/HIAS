{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Storage Service Event Schema",
  "description": "FINAL event ready for immutable storage. All services write to storage-service via this contract. Includes append-only + hash chain fields.",
  "type": "object",
  "required": [
    "trace_id",
    "timestamp",
    "student_id",
    "event",
    "confidence",
    "status",
    "source_service"
  ],
  "properties": {
    "trace_id": {
      "type": "string",
      "description": "Complete event trace ID (immutable throughout pipeline)",
      "pattern": "^HIAS-[0-9]{8}-[a-f0-9]{8}-[0-9]{6}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO8601 timestamp of original event"
    },
    "student_id": {
      "type": "string",
      "description": "Final confirmed student ID",
      "pattern": "^[A-Z0-9]{6,10}$"
    },
    "event": {
      "type": "string",
      "enum": ["ENTRY", "EXIT"],
      "description": "Event type (immutable)"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Final confidence score"
    },
    "status": {
      "type": "string",
      "enum": ["AUTO", "REVIEW", "REJECT", "CORRECTED"],
      "description": "Final status: AUTO=auto-accepted | REVIEW=pending human review | REJECT=invalid | CORRECTED=human corrected"
    },
    "source_service": {
      "type": "string",
      "enum": ["confidence_service", "human_loop_service"],
      "description": "Which service sent this record to storage"
    },
    "camera_id": {
      "type": "string",
      "description": "Camera/zone identifier"
    },
    "zone": {
      "type": "string",
      "description": "Physical zone name"
    },
    "anomaly_flags": {
      "type": "array",
      "description": "Any anomalies detected",
      "items": {"type": "string"}
    },
    "metadata": {
      "type": "object",
      "description": "Additional context for audit trail",
      "properties": {
        "correction_applied": {
          "type": "boolean",
          "description": "Whether human correction was applied"
        },
        "original_student_id": {
          "type": ["string", "null"],
          "description": "Original auto-detected student (before correction)"
        },
        "operator_id": {
          "type": ["string", "null"],
          "description": "Operator who corrected (if corrected)"
        },
        "correction_notes": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": false
}
