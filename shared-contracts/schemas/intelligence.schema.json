{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Intelligence Service Output Schema",
  "description": "Event interpretation layer. Converts recognition data into meaningful events (ENTRY/EXIT) with anomaly detection.",
  "type": "object",
  "required": [
    "trace_id",
    "timestamp",
    "student_id",
    "event",
    "confidence"
  ],
  "properties": {
    "trace_id": {
      "type": "string",
      "description": "Inherited from ingestion",
      "pattern": "^HIAS-[0-9]{8}-[a-f0-9]{8}-[0-9]{6}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO8601 timestamp of the event"
    },
    "student_id": {
      "type": "string",
      "description": "Identified student",
      "pattern": "^[A-Z0-9]{6,10}$"
    },
    "event": {
      "type": "string",
      "enum": ["ENTRY", "EXIT"],
      "description": "Interpreted event type based on time and location history"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Combined confidence (recognition × event logic confidence)"
    },
    "camera_id": {
      "type": "string",
      "description": "Camera where event occurred"
    },
    "zone": {
      "type": "string",
      "description": "Physical zone of the event"
    },
    "anomaly_flags": {
      "type": "array",
      "description": "Detected anomalies",
      "items": {
        "type": "string",
        "enum": ["DUPLICATE_ENTRY", "IMPOSSIBLE_TRANSITION", "UNUSUAL_TIME", "RAPID_MULTIPLE_ENTRIES"]
      }
    },
    "requires_review": {
      "type": "boolean",
      "description": "Flagged for manual review (based on anomalies or low confidence)"
    },
    "metadata": {
      "type": "object",
      "description": "Additional context",
      "properties": {
        "last_entry": {"type": "string", "format": "date-time"},
        "time_since_last": {"type": "number", "description": "Seconds since last event"}
      }
    }
  },
  "additionalProperties": false
}
