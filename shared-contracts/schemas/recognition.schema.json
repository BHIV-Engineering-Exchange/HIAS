{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Recognition Output Schema",
  "description": "Face detection and student identification result. Recognition service enriches ingestion event with student_id and confidence.",
  "type": "object",
  "required": [
    "trace_id",
    "timestamp",
    "student_id",
    "confidence",
    "face_detected"
  ],
  "properties": {
    "trace_id": {
      "type": "string",
      "description": "Inherited from ingestion event",
      "pattern": "^HIAS-[0-9]{8}-[a-f0-9]{8}-[0-9]{6}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO8601 timestamp of recognition"
    },
    "face_detected": {
      "type": "boolean",
      "description": "Whether a face was detected in the image"
    },
    "student_id": {
      "type": ["string", "null"],
      "description": "Identified student ID (null if no match or low confidence)",
      "pattern": "^[A-Z0-9]{6,10}$|^null$"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Confidence score for the student identification (0.0-1.0)"
    },
    "face_bbox": {
      "type": "object",
      "description": "Bounding box of detected face",
      "properties": {
        "x": {"type": "integer"},
        "y": {"type": "integer"},
        "width": {"type": "integer"},
        "height": {"type": "integer"}
      }
    },
    "similar_candidates": {
      "type": "array",
      "description": "Top 3 candidates if confidence is uncertain",
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "student_id": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0}
        }
      }
    }
  },
  "additionalProperties": false
}
